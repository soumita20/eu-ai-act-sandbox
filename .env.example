# Runtime settings are read from process environment variables.
# Copy these names into your local shell environment and replace placeholders.

# Choose "file" for the verified local JSON index or "postgres" for PostgreSQL + pgvector.
RETRIEVAL_BACKEND=file
RETRIEVAL_INDEX_PATH=data/index/regulatory-index.json

# Path must contain an already-provisioned local Sentence Transformers model.
# Model ID and revision must match those recorded in the selected published index.
EMBEDDING_MODEL_PATH=models/<local-model-directory>
EMBEDDING_MODEL_ID=<index-embedding-model-id>
EMBEDDING_MODEL_REVISION=<index-embedding-model-revision>
# "auto" lets Sentence Transformers select CUDA when available, otherwise CPU.
EMBEDDING_DEVICE=auto

# Required only when RETRIEVAL_BACKEND=postgres.
DATABASE_URL=

# PostgreSQL-only bounded timeouts: connection is 1-60 seconds (default 3);
# statement timeout is 1-60000 milliseconds per SQL statement (default 10000).
POSTGRES_CONNECT_TIMEOUT_SECONDS=3
POSTGRES_STATEMENT_TIMEOUT_MS=10000
