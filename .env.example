# Runtime settings are read from process environment variables.
# Generate API_KEY locally with secrets.token_urlsafe(32); never commit the generated value.
API_KEY=

# Per-process retrieval concurrency. Default 1 is conservative for local model/GPU memory.
API_MAX_CONCURRENT_RETRIEVALS=1

# Copy these names into your local shell environment and replace placeholders.

# Choose "file" for the verified local JSON index or "postgres" for PostgreSQL + pgvector.
RETRIEVAL_BACKEND=file
RETRIEVAL_INDEX_PATH=data/index/phase1-regulatory-index-v3.json

# API assessment persistence. Keep disabled for the file-based Demo API.
# Set to "postgres" for the authenticated Local/CI API profile.
ASSESSMENT_PERSISTENCE_BACKEND=disabled

# Required when ASSESSMENT_PERSISTENCE_BACKEND=postgres. Keep the reviewer
# identity stable and use a different high-entropy key from API_KEY.
# REVIEWER_ID=local-reviewer
# REVIEWER_API_KEY=

# Path must contain an already-provisioned local Sentence Transformers model.
# Model ID and revision must match those recorded in the selected published index.
EMBEDDING_MODEL_PATH=models/<local-model-directory>
EMBEDDING_MODEL_ID=<index-embedding-model-id>
EMBEDDING_MODEL_REVISION=<index-embedding-model-revision>
# "auto" lets Sentence Transformers select CUDA when available, otherwise CPU.
EMBEDDING_DEVICE=auto

# Required only when RETRIEVAL_BACKEND=postgres.
DATABASE_URL=

# PostgreSQL-only bounded timeouts: connection is 1-60 seconds (default 3);
# statement timeout is 1-60000 milliseconds per SQL statement (default 10000).
POSTGRES_CONNECT_TIMEOUT_SECONDS=3
POSTGRES_STATEMENT_TIMEOUT_MS=10000
# Optional OpenTelemetry tracing. Export is disabled by default.
OTEL_TRACES_EXPORTER=none
OTEL_SERVICE_NAME=eu-ai-act-sandbox-api
# For the local Jaeger viewer, set this endpoint when enabling the otlp exporter.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Optional bounded local Demo assessment history (synthetic inputs only).
DEMO_STORE_PATH=data/demo/assessments.sqlite3

# Demo abuse-reduction quotas. Counts are per Streamlit session and per SQLite instance.
DEMO_RATE_LIMIT_WINDOW_SECONDS=3600
DEMO_MAX_RUNS_PER_SESSION=5
DEMO_MAX_RUNS_GLOBAL=250
