# Copy to .env, then replace all empty secrets before starting the Local profile.
API_KEY=
REVIEWER_ID=local-reviewer
REVIEWER_API_KEY=

POSTGRES_DB=eu_ai_act_sandbox
POSTGRES_USER=sandbox
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

API_PORT=8000
REVIEWER_UI_PORT=8502

EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=b8903db39f65d93ae28d49a37c4f3fa90c5f94e0
# cpu is portable. The GPU override sets cuda:0 and reserves one available GPU.
EMBEDDING_DEVICE=cpu
